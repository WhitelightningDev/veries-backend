# App
ENVIRONMENT=development
LOG_LEVEL=INFO
APP_NAME=veries-backend
API_PREFIX=/api

# Server
HOST=0.0.0.0
PORT=8000

# Uploads (server-side)
UPLOAD_STORAGE_ROOT=var/uploads
MAX_IMAGE_UPLOAD_BYTES=10485760
MAX_VIDEO_UPLOAD_BYTES=209715200

# Vision (OpenCV) - optional upload hardening
VISION_ENABLED=true
VISION_REQUIRE_DECODABLE_IMAGES=true
VISION_ENFORCE_QUALITY=false
VISION_MIN_IMAGE_SIDE_PX=600
VISION_MIN_BLUR_VARIANCE=60.0
VISION_MAX_GLARE_RATIO=0.12
VISION_MIN_BRIGHTNESS=40.0
VISION_MAX_BRIGHTNESS=220.0
VISION_MAX_FACES=1
VISION_MIN_FACE_AREA_RATIO=0.02
VISION_MIN_DOCUMENT_AREA_RATIO=0.25

# Cloud storage (optional)
CLOUD_STORAGE_ENABLED=true
GCS_PROJECT=project-fb821ee0-b111-4380-b08
GCS_BUCKET=veries-dev-images
GCS_VIDEO_BUCKET=veries-dev-videos
