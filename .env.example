# App
ENVIRONMENT=development
LOG_LEVEL=INFO
APP_NAME=veries-backend
API_PREFIX=/api

# CORS (comma-separated origins; leave empty to disable CORS)
# Example: http://localhost:3000,http://localhost:5173
CORS_ORIGINS=
CORS_ALLOW_CREDENTIALS=false

# Server
HOST=0.0.0.0
PORT=8000

# Uploads (server-side)
UPLOAD_STORAGE_ROOT=var/uploads
MAX_IMAGE_UPLOAD_BYTES=10485760
MAX_VIDEO_UPLOAD_BYTES=209715200

# BigQuery (optional analytics)
BIGQUERY_ENABLED=false
BIGQUERY_PROJECT=
BIGQUERY_DATASET=
BIGQUERY_SESSIONS_TABLE=verification_sessions
BIGQUERY_EVENTS_TABLE=verification_session_events
# Leave empty on GCP (recommended: service account identity); set for local dev if needed:
BIGQUERY_CREDENTIALS_PATH=
BIGQUERY_LOCATION=
BIGQUERY_VALIDATE_ON_STARTUP=true
BIGQUERY_AUTOCREATE_TABLES=false
BIGQUERY_FAIL_REQUESTS=false
BIGQUERY_ASYNC_WRITES=true
BIGQUERY_ASYNC_MAX_WORKERS=2
BIGQUERY_SESSION_WRITE_MODE=merge

# Cloud storage (optional)
CLOUD_STORAGE_ENABLED=false
GCS_PROJECT=
GCS_BUCKET=
GCS_VIDEO_BUCKET=
GCS_IMAGES_PREFIX=images
GCS_VIDEOS_PREFIX=videos
# Leave empty on GCP (recommended: service account identity); set for local dev if needed:
GCS_CREDENTIALS_PATH=
