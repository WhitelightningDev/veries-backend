# App
ENVIRONMENT=development
LOG_LEVEL=INFO
APP_NAME=veries-backend
API_PREFIX=/api

# Server
HOST=0.0.0.0
PORT=8000

# Uploads (server-side)
UPLOAD_STORAGE_ROOT=var/uploads
MAX_IMAGE_UPLOAD_BYTES=10485760
MAX_VIDEO_UPLOAD_BYTES=209715200

# Cloud storage (optional)
CLOUD_STORAGE_ENABLED=true
GCS_PROJECT=project-fb821ee0-b111-4380-b08
GCS_BUCKET=veries-dev-images
GCS_VIDEO_BUCKET=veries-dev-videos